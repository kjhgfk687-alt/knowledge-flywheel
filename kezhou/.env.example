# 客舟（KeZhou）环境配置示例：复制为 .env 使用，前缀 KEZHOU_

# ---- 知源 /retrieve 连接（契约 v1.1，见 2026-09-22_接口契约+项目设计/知源retrieve接口契约.md）----
# 检索实现：mock（阶段一/演示，配 MOCK_SCENARIO）| zhiyuan（真 REST 客户端，需知源在 8100 运行）
KEZHOU_RETRIEVE_PROVIDER=mock
KEZHOU_ZHIYUAN_BASE_URL=http://localhost:8100
KEZHOU_ZHIYUAN_API_KEY=zs-kz-dev-key-001
# 客户端超时 3.5s > 知源侧总预算 3s（含向量尝试+关键词降级，504 由知源先抛）。
# 留余量是为了让知源的 504 错误信封能到达并被归类解析；知源预算变更时此处必须同步。
KEZHOU_RETRIEVE_TIMEOUT_SECONDS=3.5
# 重试开关：阶段二启用的真实参数（0=不重试），供真实 client 消费；MockRetrievalClient 不重试
KEZHOU_RETRIEVE_MAX_RETRIES=0

# ---- 阶段一 Mock 检索场景：ok | empty | degraded | error | timeout ----
KEZHOU_RETRIEVE_MOCK_SCENARIO=ok

# ---- 案例回写（契约 v1.3 §7 POST /api/v1/cases，飞轮沉淀端）----
# dryrun = 只记录不真调（测试/演示）；zhiyuan = 真 REST 调知源（需知源 8100 在线）
KEZHOU_WRITEBACK_PROVIDER=dryrun

# ---- LLM（阶段一默认 mock，无需密钥；接真实模型时改 provider 为 openai_compatible）----
KEZHOU_LLM_PROVIDER=mock
KEZHOU_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
KEZHOU_LLM_API_KEY=
KEZHOU_LLM_MODEL=glm-4-flash

# ---- 阈值与记忆 ----
KEZHOU_INTENT_CONFIDENCE_THRESHOLD=0.6
KEZHOU_CONFIDENCE_LOW_THRESHOLD=0.55
# 三维风控（鉴定状态 × 品类 × 金额）
KEZHOU_AUTO_REFUND_MAX=1000
KEZHOU_HIGH_VALUE_THRESHOLD=5000
KEZHOU_HISTORY_WINDOW=10
KEZHOU_LONG_TERM_UPDATE_INTERVAL=5
# JSON 数组格式
KEZHOU_EMOTION_KEYWORDS=["投诉","315","垃圾","骗子","举报","工商","消协","差评","退我钱"]

# ---- 存储 ----
KEZHOU_DB_PATH=db/kezhou.sqlite
# LangGraph checkpointer 库（留空自动取 <DB_PATH> 同目录 *_checkpoints.sqlite）。
# 必须与业务库分文件：同文件多连接写锁竞争会间歇性停顿 ~11s。
KEZHOU_CHECKPOINT_DB_PATH=
