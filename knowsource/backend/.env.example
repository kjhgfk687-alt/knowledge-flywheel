# 知源后端配置模板。复制为 .env 后按需修改。
# 数据库（docker-compose 默认值）
DATABASE_URL=postgresql+psycopg://ks:ks@localhost:5432/knowsource
# Chroma 持久化目录（相对 backend/）
CHROMA_DIR=./data/chroma
# 嵌入：fastembed（本地 ONNX）| openai_compatible
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 与客舟共享的服务间密钥（契约 §1）
KS_API_KEY=zs-kz-dev-key-001
# 检索预算（契约 §5）
VECTOR_TIMEOUT_MS=800
RETRIEVAL_TOTAL_BUDGET_MS=3000
# 切分参数（守住 bge 512 token 上限）
CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K_MAX=20
